  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hlenwvmehbidfpjhbcqu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "iron-plate-oracle",
      "version": "0.1.0",
      "title": "Iron Plate Oracle"
